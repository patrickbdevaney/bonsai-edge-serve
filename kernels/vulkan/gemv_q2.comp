#version 450
// Batch-1 Q2_0 GEMV, Vulkan compute.
//
// Same packed weight format as the CUDA and NEON backends, and -- because
// dotPacked4x8AccSatEXT consumes a single 32-bit word exactly like CUDA's
// __dp4a -- the SAME activation layout as CUDA too, with no permutation.
// Only the NEON backend needs an activation shuffle, because its vector
// is 16 bytes and spans four weight words.
//
// The biased-encoding identity (see ../common/bonsai_gemv.h):
//     sum w*x = d*da * ( sum c*a - sum a )
// so the inner loop dots the RAW codes {0,1,2,3} and corrects once per
// 16-weight word with a precomputed activation sum. No sign handling.
//
// Portability notes, both load-bearing:
//  * dotPacked4x8AccSatEXT is the PACKED form. Thor (and NVIDIA/Adreno/
//    Intel Arc generally) reports
//    integerDotProduct4x8BitPackedSignedAccelerated = true while
//    integerDotProduct8BitSignedAccelerated = false, so the i8vec4 form
//    is NOT the accelerated path. Always emit the packed uint form.
//    VK_KHR_shader_integer_dot_product covers ~70% of devices, so a
//    scalar fallback shader is required for the rest.
//  * The cross-lane reduction is done in shared memory rather than with
//    subgroup ops, because subgroup width varies 16..128 across vendors
//    (Mali 16, NVIDIA 32, AMD reports 64, Adreno 64/128) and cannot be
//    pinned at all on Apple. A subgroupAdd fast path can be added behind
//    a feature query; this is the version that runs everywhere.
//  * Weights live in an SSBO, never a UBO or push constant -- 8-bit
//    storage in those is broken on about half of Android.

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

// Tier 3 fast path when VK_KHR_shader_integer_dot_product is present
// (~70% of devices) AND the toolchain knows the extension. Compile with
// -DUSE_INT_DOT to enable. Everything else takes the portable Tier 1
// path below, which is plain integer arithmetic and runs on any
// Vulkan 1.1 device.
#ifdef USE_INT_DOT
#extension GL_EXT_integer_dot_product : require
#endif

// Sign-extend byte k of a packed int8x4 word.
int sb(uint p, int k) { return (int(p << (24 - 8 * k))) >> 24; }

// dot4(codes, acts): codes is 4 unsigned 2-bit values in byte lanes,
// acts is 4 packed int8. Identical semantics to __dp4a / dotPacked4x8.
int dot4(uint c, uint a, int acc) {
#ifdef USE_INT_DOT
    // Overload selection matters: the activations are packed SIGNED int8
    // and the codes are unsigned, so cast to reach
    //   int dotPacked4x8AccSatEXT(uint a, int b, int c)
    // Passing both as uint silently picks the all-unsigned overload, which
    // returns uint and treats activations as 0..255 -- wrong answers, and
    // it will not even compile against an int accumulator.
    return dotPacked4x8AccSatEXT(c, int(a), acc);
#else
    acc += int((c      ) & 0xFFu) * sb(a, 0);
    acc += int((c >>  8) & 0xFFu) * sb(a, 1);
    acc += int((c >> 16) & 0xFFu) * sb(a, 2);
    acc += int((c >> 24) & 0xFFu) * sb(a, 3);
    return acc;
#endif
}

// Build four consecutive 2-bit codes from byte p of a GGUF-order word.
#ifdef ALU_PROBE
// ALU PROBE: numerically WRONG on purpose. Keeps the load and the four
// dot4 calls, removes the extraction arithmetic, to separate "this kernel
// is memory-bound" from "this kernel is extraction-bound".
uint unpack_gguf(uint w, uint p) { return w + p; }
#else
uint unpack_gguf(uint w, uint p) {
    const uint c4 = (w >> (8u * p)) & 0xFFu;
    return  (c4        & 3u)
         | (((c4 >> 2) & 3u) <<  8)
         | (((c4 >> 4) & 3u) << 16)
         | (((c4 >> 6) & 3u) << 24);
}
#endif

#define LANES 32
#define TEAMS 8
#define ROWS  4

layout(local_size_x = LANES, local_size_y = TEAMS, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer Weights { uint  w[]; };   // [N][K/16]
layout(std430, binding = 1) readonly  buffer Scales  { float s[]; };   // [N][K/128]
layout(std430, binding = 2) readonly  buffer Acts    { uint  a[]; };   // [K/4] int8x4
layout(std430, binding = 3) readonly  buffer ASum    { int   asum[]; };// [K/16]
layout(std430, binding = 4) writeonly buffer Out     { float o[]; };

layout(push_constant) uniform Push {
    int   N;
    int   K;
    float da;
} pc;

shared float red[TEAMS][ROWS][LANES];

void main() {
    const int lane = int(gl_LocalInvocationID.x);
    const int team = int(gl_LocalInvocationID.y);
    const int row0 = (int(gl_WorkGroupID.x) * TEAMS + team) * ROWS;

    const int nw   = pc.K / 16;
    const int nblk = pc.K / 128;

    float accf[ROWS];
    for (int r = 0; r < ROWS; ++r) accf[r] = 0.0;

    if (row0 < pc.N) {
#ifdef WIDE4
        // WIDE4: each lane reads FOUR CONSECUTIVE words per row, issued
        // BACK TO BACK before anything is consumed, so the driver can merge
        // them into one wide transaction.
        //
        // Measured on Thor (kernels/vulkan/bandwidth_vk.cpp): a Vulkan
        // shader reading one 32-bit word per lane per iteration tops out at
        // 135-180 GB/s, while uvec4 loads AND four consecutive scalar loads
        // both reach 241-249 GB/s -- matching CUDA's 244.7. The merge only
        // happens for loads that are consecutive PER LANE and adjacent in
        // program order; interleaving other work between them loses it,
        // which an earlier version of this variant demonstrated by going
        // SLOWER (105 vs 130 GB/s).
        //
        // This is the opposite of the CUDA result, where explicit uint4
        // loads bought nothing because the hardware already coalesced the
        // lane-strided form (WIKI K2/v6). That rule does not port.
        for (int wbase = lane * 4; wbase < nw; wbase += LANES * 4) {
            uint vv[ROWS][4];
            for (int r = 0; r < ROWS; ++r) {
                const int base = (row0 + r) * nw + wbase;
                vv[r][0] = w[base + 0];
                vv[r][1] = w[base + 1];
                vv[r][2] = w[base + 2];
                vv[r][3] = w[base + 3];
            }
            for (int sub = 0; sub < 4; ++sub) {
            const int widx = wbase + sub;
#else
        for (int widx = lane; widx < nw; widx += LANES) {
#endif
            // Issue all ROWS weight loads before consuming any: these are
            // independent and this is the whole source of memory-level
            // parallelism at batch 1.
#ifndef WIDE4
            uint v[ROWS];
            for (int r = 0; r < ROWS; ++r) v[r] = w[(row0 + r) * nw + widx];
#else
            uint v[ROWS];
            for (int r = 0; r < ROWS; ++r) v[r] = vv[r][sub];
#endif

            const uint a0 = a[widx * 4 + 0];
            const uint a1 = a[widx * 4 + 1];
            const uint a2 = a[widx * 4 + 2];
            const uint a3 = a[widx * 4 + 3];
            const int  cs = asum[widx];

            for (int r = 0; r < ROWS; ++r) {
                int d = 0;
                // Shift 2q selects logical base+4q+0..3 -- four
                // CONSECUTIVE weights, matching one aligned activation
                // word. That is what the bit-plane repack buys.
#ifdef GGUF_ORDER
                // GGUF order: byte p of the word holds logical weights
                // 4p..4p+3 at shifts 0,2,4,6. The Q2_K-style
                // `(w >> s) & 0x03030303` trick does NOT apply here -- it
                // would select the same field from each byte, i.e. weights
                // strided by 4, and pair them with the wrong activations.
                // Extract per byte into consecutive lanes instead.
                d = dot4(unpack_gguf(v[r], 0), a0, d);
                d = dot4(unpack_gguf(v[r], 1), a1, d);
                d = dot4(unpack_gguf(v[r], 2), a2, d);
                d = dot4(unpack_gguf(v[r], 3), a3, d);
#else
                d = dot4( v[r]        & 0x03030303u, a0, d);
                d = dot4((v[r] >>  2) & 0x03030303u, a1, d);
                d = dot4((v[r] >>  4) & 0x03030303u, a2, d);
                d = dot4((v[r] >>  6) & 0x03030303u, a3, d);
#endif
                accf[r] += s[(row0 + r) * nblk + (widx >> 3)] * float(d - cs);
            }
#ifdef WIDE4
          }
#endif
        }
    }

    for (int r = 0; r < ROWS; ++r) red[team][r][lane] = accf[r];
    barrier();

    for (int off = LANES / 2; off > 0; off >>= 1) {
        if (lane < off)
            for (int r = 0; r < ROWS; ++r)
                red[team][r][lane] += red[team][r][lane + off];
        barrier();
    }

    if (lane == 0 && row0 < pc.N) {
        for (int r = 0; r < ROWS; ++r)
            if (row0 + r < pc.N) o[row0 + r] = red[team][r][0] * pc.da;
    }
}
