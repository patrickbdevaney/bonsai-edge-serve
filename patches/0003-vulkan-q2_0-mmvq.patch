diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 73cf9c799..8d0c4f882 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -29,6 +29,50 @@ FLOAT_TYPEV2 get_dm(uint ib) {
 }
 #endif
 
+#if defined(DATA_A_Q2_0)
+// Q2_0 (Bonsai ternary): 128 quants per 34-byte block. `ib` is a virtual
+// index in units of 32 quants (QUANT_K_Q8_1), so the real block is ib/4.
+FLOAT_TYPE get_dm(uint ib) {
+    return FLOAT_TYPE(data_a[ib / 4].d);
+}
+
+// GGUF order: byte p of the word holds logical weights 4p..4p+3 at shifts
+// 0,2,4,6. Q2_K's `(w >> s) & 0x03030303` does NOT work here -- it takes
+// the same field from each byte, i.e. weights strided by 4, silently paired
+// with the wrong activations. Extract per byte instead. Validated against a
+// CPU reference in bonsai-edge-serve (kernels/vulkan/gemv_q2.comp,
+// -DGGUF_ORDER): max rel err 4.783e-06, and 2-8% FASTER than a repack.
+int32_t q2_0_codes(uint w, uint p) {
+    const uint c4 = (w >> (8u * p)) & 0xFFu;
+    return int32_t( (c4        & 3u)
+                 | (((c4 >> 2) & 3u) <<  8)
+                 | (((c4 >> 4) & 3u) << 16)
+                 | (((c4 >> 6) & 3u) << 24));
+}
+
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    // 8 words of 16 quants per block; sub-block (ib_a%4) covers words
+    // 2*(ib_a%4) and +1, and iqs picks the half. 2-byte loads, see the
+    // alignment note on block_q2_0_packed16 in types.glsl.
+    const uint wi = ((ib_a % 4) * 2 + iqs) * 2;
+    const uint w = pack32(u16vec2(data_a_packed16[ib_a / 4].qs[wi    ],
+                                  data_a_packed16[ib_a / 4].qs[wi + 1]));
+
+    int32_t q_sum = 0;
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 0), cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 1), cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 2), cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 3), cache_b_qs[3]);
+
+    // Codes {0,1,2,3} represent values {-1,0,1,2}, so sum(v*b) =
+    // sum(c*b) - sum(b). cache_b_ds.y is d_b*sum(q) over all 32 quants of
+    // the q8_1 block, and 32/K_PER_ITER = 2 calls cover it, so each call
+    // takes half. Same identity as the CUDA and NEON backends.
+    return FLOAT_TYPE(float(get_dm(ib_a))
+                      * (float(q_sum) * cache_b_ds.x - 0.5 * cache_b_ds.y));
+}
+#endif
+
