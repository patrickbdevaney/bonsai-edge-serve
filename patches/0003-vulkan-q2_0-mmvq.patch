 };
 
+// A Q2_0 block is 2 + 32 = 34 bytes and therefore only 2-byte aligned.
+// A uint32_t member would force std430 alignment 4, padding the array
+// stride to 36 and misreading every block after the first. Q4_0 (18
+// bytes) uses a packed16 view for exactly this reason.
+struct block_q2_0_packed16
+{
+    float16_t d;
+    uint16_t qs[QUANT_K_Q2_0 / 8];
+};
+
 #if defined(DATA_A_Q2_0)
 #define QUANT_K QUANT_K_Q2_0
 #define QUANT_R QUANT_R_Q2_0
 #define QUANT_AUXF 1
 #define A_TYPE block_q2_0
+#define A_TYPE_PACKED16 block_q2_0_packed16
 #endif
 
 
