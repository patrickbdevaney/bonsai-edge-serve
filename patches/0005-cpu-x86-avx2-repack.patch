             }
         }
+        // No AVX2-tier selection for q1_0: measured parity with the
+        // existing x86 vec_dot path (llama-bench tg128 9.6 vs 10.0,
+        // pp512 24.2 vs 25.4 on i9-14900HX), matching the ARM finding
+        // that 1-bit gains nothing from this kernel shape. The AVX2
+        // 4x8 kernels exist and validate; they are just not selected.
         // EXPERIMENT (bonsai-edge-serve): Q1_0 has ARM repack kernels and
         // Q2_0 does not. Turning Q1_0's off measures what the repack path is
         // actually worth on this core, which is what decides whether writing
@@ -5387,6 +5392,16 @@ static const ggml::cpu::tensor_traits * ggml_repack_get_optimal_repack_type(cons
                 return &q2_0_4x8_q8_0;
             }
         }
+        // AVX2 tier (bonsai-edge-serve): consumer parts with AVX-512
+        // fused off (e.g. Raptor Lake) otherwise take the vec_dot path,
+        // measured 3.4x slower at pp512 and 1.8x at tg128 than these
+        // kernels' VEX branch (llama-bench, i9-14900HX).
+        // BONSAI_NO_ARM_REPACK doubles as the generic-path A/B switch.
+        if (!getenv("BONSAI_NO_ARM_REPACK") && ggml_cpu_has_avx2()) {
