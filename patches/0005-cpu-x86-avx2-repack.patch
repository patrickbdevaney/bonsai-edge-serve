+// AVX2 / AVX-VNNI helpers for the Q1_0/Q2_0 4-column interleaved
+// kernels -- the VEX-width mirror of the AVX512 block above, for parts
+// like consumer Raptor Lake where AVX-512 is fused off. One 256-bit
+// vector holds one column's 32-value sub-block; each output row keeps
+// four per-column fp32 accumulators reduced once per tile.
+//
+// The dot step is u8 x s8 -> s32. With AVX-VNNI that is VPDPBUSD; on
+// plain AVX2 the same contraction is VPMADDUBSW + VPMADDWD, exact here
+// because codes <= 3 and |a| <= 127 keep the s16 intermediate at 762.
+static inline __m256i __bonsai_dpbusd(__m256i acc, __m256i u, __m256i s) {
+#if defined(__AVXVNNI__)
+    return _mm256_dpbusd_avx_epi32(acc, u, s);
+#elif defined(__AVX512VNNI__) && defined(__AVX512VL__)
+    return _mm256_dpbusd_epi32(acc, u, s);
+#else
+    return _mm256_add_epi32(acc, _mm256_madd_epi16(
+        _mm256_maddubs_epi16(u, s), _mm256_set1_epi16(1)));
+#endif
+}
