+static inline __m256i __q2_0_expand_col(const uint8_t * qs, int c) {
+    const __m256i m3 = _mm256_set1_epi8(0x03);
+    const __m256i v  = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) (qs + 8 * c)));
+    const __m256i r  = _mm256_or_si256(_mm256_or_si256(v, _mm256_slli_epi32(v, 6)),
+                                       _mm256_or_si256(_mm256_slli_epi32(v, 12),
+                                                       _mm256_slli_epi32(v, 18)));
+    return _mm256_and_si256(r, m3);
+}
+
+// Expand column c of a q1_0x4 32-value sub-block (byte 4j + c = bits
+// for values 8j..8j+7 of column c) to 32 {0,1} bytes. The shuffle
+// replicates each source byte across 8 lanes; the cmpeq against the
+// per-lane bit mask turns bit i into byte {0,1}.
+static inline __m256i __q1_0_expand_col(__m256i bits2x128, int c) {
+    const __m256i bitmask = _mm256_set1_epi64x((long long) 0x8040201008040201ull);
+    // lane 0 wants source bytes c and c+4; lane 1 wants c+8 and c+12,
+    // but shuffle indexes within each 128-bit lane, and both lanes hold
+    // the same 16 source bytes (broadcast), so the mask is per-lane.
+    const __m256i sel = _mm256_setr_epi8(
+        c, c, c, c, c, c, c, c, c + 4, c + 4, c + 4, c + 4, c + 4, c + 4, c + 4, c + 4,
+        c + 8, c + 8, c + 8, c + 8, c + 8, c + 8, c + 8, c + 8,
+        c + 12, c + 12, c + 12, c + 12, c + 12, c + 12, c + 12, c + 12);
+    const __m256i rep = _mm256_shuffle_epi8(bits2x128, sel);
+    const __m256i hit = _mm256_cmpeq_epi8(_mm256_and_si256(rep, bitmask), bitmask);
+    return _mm256_and_si256(hit, _mm256_set1_epi8(1));
+}
