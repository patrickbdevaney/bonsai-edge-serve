+// q2_0 gemv, 4 interleaved columns, q8_0 activations.
+//
+// The trick that makes this cheap is vld4_s8. A whole-vector AND/SHIFT unpack
+// gives, for byte b, the code for activation 4b+i at shift 2i -- so the four
+// unpacked vectors want activations {0,4,8,...}, {1,5,9,...}, {2,6,...} and
+// {3,7,...}. That is a 4-way deinterleave, which vld4_s8 does in ONE
+// instruction. So the packed weights are consumed in their existing repack
+// layout (qs + k*32 + j*8) with no shuffling and no separate weight permute.
+//
+// Codes are {0,1,2,3} biased by -1, and the raw codes are what AND/SHIFT
+// produce, so this dots the RAW codes and applies the bias once per 32-value
+// block: sum(w*a) = sum(c*a) - sum(a). One vaddlvq pair per block instead of
+// a subtract per weight.
+void ggml_gemv_q2_0_4x8_q8_0(int                        n,
+                             float * GGML_RESTRICT      s,
+                             size_t                     bs,
+                             const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy,
+                             int                        nr,
+                             int                        nc) {
+    const int qk                = QK2_0;
+    const int nb                = n / qk;
+    const int ncols_interleaved = 4;
+
+    assert(n % qk == 0);
+    assert(nc % ncols_interleaved == 0);
+
+    UNUSED(nb);
+    UNUSED(ncols_interleaved);
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    const uint8x16_t m3 = vdupq_n_u8(0x03);
+
+    for (int c = 0; c < nc; c += ncols_interleaved) {
+        const block_q2_0x4 * b_ptr = (const block_q2_0x4 *) vx + (c / ncols_interleaved) * nb;
+        const block_q8_0 *   a_ptr = (const block_q8_0 *) vy;
+        float32x4_t acc = vdupq_n_f32(0);
+
+        for (int l = 0; l < nb; l++) {
+            const float32x4_t b_d = vcvt_f32_f16(vld1_f16((const float16_t *) b_ptr[l].d));
+            float32x4_t accb = vdupq_n_f32(0);
+
+            for (int k = 0; k < 4; ++k) {
+                const block_q8_0 * GGML_RESTRICT a_blk = a_ptr + l * 4 + k;
+                const uint8_t *    GGML_RESTRICT b_qs  = (const uint8_t *) b_ptr[l].qs + k * 32;
+                const float                      ad    = GGML_CPU_FP16_TO_FP32(a_blk->d);
+
+                // y.val[i] = a[i], a[i+4], a[i+8], ... -- the order the
+                // shift-by-2i unpack needs. Duplicated so one 128-bit vector
+                // serves both interleaved columns in a load.
+                const int8x8x4_t y  = vld4_s8(a_blk->qs);
+                const int8x16_t  y0 = vcombine_s8(y.val[0], y.val[0]);
+                const int8x16_t  y1 = vcombine_s8(y.val[1], y.val[1]);
+                const int8x16_t  y2 = vcombine_s8(y.val[2], y.val[2]);
+                const int8x16_t  y3 = vcombine_s8(y.val[3], y.val[3]);
+
+                const int32_t asum = (int32_t) vaddlvq_s8(vld1q_s8(a_blk->qs)) +
+                                     (int32_t) vaddlvq_s8(vld1q_s8(a_blk->qs + 16));
+
+                const uint8x16_t v01 = vld1q_u8(b_qs);        // columns 0,1
+                const uint8x16_t v23 = vld1q_u8(b_qs + 16);   // columns 2,3
+
+                int32x4_t r01 = vdupq_n_s32(0);
+                int32x4_t r23 = vdupq_n_s32(0);
+
+                r01 = vdotq_s32(r01, vreinterpretq_s8_u8(vandq_u8(v01, m3)), y0);
+                r01 = vdotq_s32(r01, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(v01, 2), m3)), y1);
+                r01 = vdotq_s32(r01, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(v01, 4), m3)), y2);
+                r01 = vdotq_s32(r01, vreinterpretq_s8_u8(vshrq_n_u8(v01, 6)), y3);
+
+                r23 = vdotq_s32(r23, vreinterpretq_s8_u8(vandq_u8(v23, m3)), y0);
+                r23 = vdotq_s32(r23, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(v23, 2), m3)), y1);
+                r23 = vdotq_s32(r23, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(v23, 4), m3)), y2);
+                r23 = vdotq_s32(r23, vreinterpretq_s8_u8(vshrq_n_u8(v23, 6)), y3);
+
+                // r01 = [col0_lo, col0_hi, col1_lo, col1_hi]; pair-add folds
+                // each column's two halves, giving [c0, c1, c2, c3].
+                int32x4_t sums = vpaddq_s32(r01, r23);
+                sums = vsubq_s32(sums, vdupq_n_s32(asum));
+
+                accb = vfmaq_n_f32(accb, vcvtq_f32_s32(sums), ad);
+            }
+
+            acc = vfmaq_f32(acc, accb, b_d);
+        }
+
+        vst1q_f32(s, acc);
+        s += ncols_interleaved;
+    }
+    return;
+#endif
+
+    ggml_gemv_q2_0_4x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+}
