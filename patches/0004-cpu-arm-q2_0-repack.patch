+// q2_0: one byte holds four 2-bit codes {0,1,2,3} standing for {-1,0,1,2}.
+// table_q2_vals[byte] packs the four DEBIASED int8 values (code - 1) into a
+// uint32, so an unpack is a load rather than a shift/mask/subtract chain.
+// This mirrors table_q1_signs, and it is what lets the i8mm gemm below feed
+// vmmlaq_s32 directly -- that instruction needs true signed operands, so the
+// usual "dot the raw codes and subtract sum(a)" trick is not available there.
+#define Q2V(b)  ((uint32_t) (uint8_t) ((int8_t) (((b) & 3)) - 1))
+#define Q2E(b)  (Q2V(b) | (Q2V((b) >> 2) << 8) | (Q2V((b) >> 4) << 16) | (Q2V((b) >> 6) << 24))
+#define Q2T1(n) Q2E(n),      Q2E((n) + 1),  Q2E((n) + 2),  Q2E((n) + 3)
+#define Q2T2(n) Q2T1(n),     Q2T1((n) + 4), Q2T1((n) + 8), Q2T1((n) + 12)
+#define Q2T3(n) Q2T2(n),     Q2T2((n) + 16), Q2T2((n) + 32), Q2T2((n) + 48)
+#define Q2T4    Q2T3(0),     Q2T3(64),       Q2T3(128),      Q2T3(192)
+
+static const uint32_t table_q2_vals[256] = { Q2T4 };
+
+// 4 packed bytes -> 16 debiased int8 weights, in natural activation order.
+static inline int8x16_t ggml_q2_0_unpack_quad(const uint8_t * GGML_RESTRICT b, int i0, int i1, int i2, int i3) {
+    const uint32_t v[4] = { table_q2_vals[b[i0]], table_q2_vals[b[i1]],
+                            table_q2_vals[b[i2]], table_q2_vals[b[i3]] };
+    return vreinterpretq_s8_u32(vld1q_u32(v));
+}
