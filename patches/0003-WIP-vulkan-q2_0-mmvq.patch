diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 73cf9c799..dc18af306 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -22,6 +22,43 @@ FLOAT_TYPE get_dm(uint ib) {
 }
 #endif
 
+#if defined(DATA_A_Q2_0)
+// Q2_0: 128 quants/block, so a virtual 32-quant index ib maps to real
+// block ib/4. mmvq_dot_product handles 16 quants, i.e. one 32-bit word.
+FLOAT_TYPE get_dm(uint ib) {
+    return FLOAT_TYPE(data_a[ib / 4].d);
+}
+
+// GGUF order: byte p of the word holds logical weights 4p..4p+3 at
+// shifts 0,2,4,6. Q2_K's `(w >> s) & 0x03030303` does NOT work here --
+// it would take the same field from each byte, i.e. weights strided by
+// 4, silently paired with the wrong activations. Extract per byte.
+// Validated against a CPU reference in bonsai-edge-serve
+// (kernels/vulkan, -DGGUF_ORDER): max rel err 4.783e-06.
+int32_t q2_0_codes(uint w, uint p) {
+    const uint c4 = (w >> (8u * p)) & 0xFFu;
+    return int32_t( (c4        & 3u)
+                 | (((c4 >> 2) & 3u) <<  8)
+                 | (((c4 >> 4) & 3u) << 16)
+                 | (((c4 >> 6) & 3u) << 24));
+}
+
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint w = data_a_packed32[ib_a / 4].qs[(ib_a % 4) * 2 + iqs];
+    int32_t q_sum = 0;
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 0), cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 1), cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 2), cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(q2_0_codes(w, 3), cache_b_qs[3]);
+    // codes are {0,1,2,3} for values {-1,0,1,2}: subtract the bias of 1
+    // times the activation sum. cache_b_ds.y covers 32 quants and we did
+    // 16, hence the /2.
+    return FLOAT_TYPE(float(get_dm(ib_a))
+                      * (float(q_sum) * float(cache_b_ds.x)
+                         - float(cache_b_ds.y) * 0.5));
+}
+#endif
+
 #if defined(DATA_A_Q2_K)
 FLOAT_TYPEV2 get_dm(uint ib) {
     const uint ib_k = ib / 8;
